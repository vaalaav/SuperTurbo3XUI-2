{
  "id": "dev-docs",
  "title": "Developer API Portal",
  "description": "Портал документации разработчика: справочник эндпоинтов, аутентификация JWT/API Key, OpenAPI и changelog",
  "brand_nouns": ["Platform", "Gateway", "Core", "Compute", "API"],
  "taglines": [
    "REST and webhook primitives for automated infrastructure workflows",
    "Low-latency service APIs with JWT bearer authentication and strict schema validation",
    "Developer documentation, SDK guides, and OpenAPI specifications"
  ],
  "email_locals": ["devrel", "api", "support", "security"],
  "pages": [
    "/",
    "/endpoints/",
    "/authentication/",
    "/changelog/"
  ],
  "robots_disallow": [
    "/api/",
    "/internal/"
  ],
  "themes": [
    {
      "name": "zinc-blue",
      "bg": "#18181b",
      "surface": "#202024",
      "surface_alt": "#27272a",
      "border": "#3f3f46",
      "fg": "#e4e4e7",
      "muted": "#a1a1aa",
      "accent": "#60a5fa",
      "accent_fg": "#0b192c",
      "ok": "#4ade80"
    },
    {
      "name": "obsidian-violet",
      "bg": "#13111c",
      "surface": "#1b1826",
      "surface_alt": "#242033",
      "border": "#36304a",
      "fg": "#ede9fe",
      "muted": "#a7a0bf",
      "accent": "#a78bfa",
      "accent_fg": "#1e1038",
      "ok": "#34d399"
    },
    {
      "name": "midnight-cyan",
      "bg": "#0e141b",
      "surface": "#151d26",
      "surface_alt": "#1c2733",
      "border": "#2a3847",
      "fg": "#e6edf3",
      "muted": "#8b949e",
      "accent": "#39c5cf",
      "accent_fg": "#042024",
      "ok": "#3fb950"
    }
  ],
  "api_endpoints": [
    {
      "path": "/api/v1/status",
      "status": 200,
      "content_type": "application/json",
      "body": {
        "service": "__BRAND_RAW__",
        "domain": "__DOMAIN__",
        "api_version": "v__VERSION__",
        "region": "__REGION__",
        "status": "operational"
      }
    },
    {
      "path": "/api/v1/health",
      "status": 200,
      "content_type": "application/json",
      "body": {
        "ok": true,
        "uptime": "__UPTIME__"
      }
    },
    {
      "path": "/api/v1/auth/token",
      "status": 401,
      "content_type": "application/json",
      "rate_limit": "zone=auth_limit burst=2 nodelay",
      "body": {
        "error": "unauthorized",
        "message": "Valid client_id and client_secret required"
      }
    }
  ]
}
