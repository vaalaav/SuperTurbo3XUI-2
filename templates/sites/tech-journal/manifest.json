  "api_endpoints": [
    {
      "path": "/api/v1/status",
      "status": 200,
      "content_type": "application/json",
      "body": {
        "publication": "__BRAND_RAW__",
        "domain": "__DOMAIN__",
        "edition": "__VERSION__",
        "status": "online"
      }
    },
    {
      "path": "/api/v1/newsletter",
      "status": 202,
      "content_type": "application/json",
      "rate_limit": "zone=auth_limit burst=2 nodelay",
      "body": {
        "subscribed": true,
        "message": "Check your inbox to confirm your weekly engineering digest subscription."
      }
    }
  ]
}
