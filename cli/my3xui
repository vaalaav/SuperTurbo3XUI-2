#!/usr/bin/env bash
# DESC: Управление узлом 3x-ui, SSH (Termius), защитой и аудитом
set -eu

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

STATE_FILE="/etc/3xui-node/state.env"
INSTALL_DIR="@BASE_DIR@"   # модуль 08 подставляет каталог установки
[[ "$INSTALL_DIR" == @* ]] && INSTALL_DIR="/opt/3xui-node"   # запуск из репозитория без установки
INFO_FILE="/root/vps-credentials.txt"

[[ $EUID -eq 0 ]] || { echo -e "${RED}Запустите от root: sudo my3xui${NC}"; exit 1; }
# shellcheck disable=SC1090
[[ -f "$STATE_FILE" ]] && source "$STATE_FILE"

show_info() {
    echo -e "\n${BOLD}${CYAN}=== ИНФОРМАЦИЯ О СИСТЕМЕ ===${NC}"
    local cpu cores freq mem swap xui_v xray_v xray_bin
    cpu=$(awk -F: '/model name/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo)
    cores=$(nproc)
    if [[ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq ]]; then
        freq=$(awk '{printf "%.0f MHz", $1/1000}' /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq)
    else
        freq=$(awk -F: '/cpu MHz/ {gsub(/^[ \t]+/, "", $2); printf "%.0f MHz", $2; exit}' /proc/cpuinfo || echo "N/A")
    fi
    mem=$(free -h | awk '/^Mem:/ {print $3 "/" $2 " (free: " $7 ")"}')
    swap=$(free -h | awk '/^Swap:/ {print $3 "/" $2}')
    xui_v=$(/usr/local/x-ui/x-ui -v 2>/dev/null | head -n 1 || echo "N/A")
    xray_bin=$(find /usr/local/x-ui/bin -maxdepth 1 -name "xray-linux-*" -type f 2>/dev/null | head -n 1 || true)
    xray_v=$([[ -n "$xray_bin" ]] && "$xray_bin" version 2>/dev/null | awk 'NR==1 {print $2}' || echo "N/A")

    echo "  CPU:    ${cpu:-Unknown} (${cores}c @ ${freq})"
    echo "  RAM:    ${mem} | Swap: ${swap}"
    echo "  3x-ui:  ${xui_v} | Xray: ${xray_v}"
    echo "  Диски:"
    lsblk -d -n -o NAME,SIZE 2>/dev/null | while read -r dev size; do
        [[ -z "$dev" || "$dev" =~ ^(loop|ram|sr|fd|zram) ]] && continue
        local rota disc tran dtype
        rota=$(cat "/sys/block/${dev}/queue/rotational" 2>/dev/null || echo "1")
        disc=$(cat "/sys/block/${dev}/queue/discard_max_bytes" 2>/dev/null || echo "0")
        tran=$(lsblk -d -n -o TRAN "/dev/${dev}" 2>/dev/null | xargs || true)
        if [[ "$dev" == nvme* || "$tran" == "nvme" ]]; then dtype="NVMe SSD"
        elif [[ "$rota" == "0" ]]; then dtype="SSD"
        elif [[ "$dev" == vd* || "${disc:-0}" -gt 0 ]]; then dtype="Virtual SSD"
        else dtype="HDD"; fi
        echo "    /dev/${dev}: ${size} [${dtype}]"
    done
    echo "  Занято /: $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')"
    echo ""
}

show_creds() {
    echo -e "\n${BOLD}${CYAN}=== ДАННЫЕ ДОСТУПА ===${NC}"
    if [[ -f "$INFO_FILE" ]]; then
        cat "$INFO_FILE"
    else
        echo -e "${YELLOW}Файл ${INFO_FILE} не найден.${NC}"
    fi
    echo ""
}

show_crowdsec_block() {
    echo -e "\n${BOLD}[CrowdSec]${NC}"
    if ! command -v cscli >/dev/null 2>&1; then
        echo -e "  Статус: ${YELLOW}не установлен${NC}"
        return 0
    fi
    local cs_act bnc_act cs_en
    cs_act=$(systemctl is-active crowdsec 2>/dev/null || true)
    bnc_act=$(systemctl is-active crowdsec-firewall-bouncer 2>/dev/null || true)
    cs_en=$(systemctl is-enabled crowdsec 2>/dev/null || true)
    if [[ "$cs_act" == "active" && "$bnc_act" == "active" ]]; then
        echo -e "  Статус: ${GREEN}ВКЛЮЧЁН${NC} (crowdsec: ${cs_act}, bouncer: ${bnc_act})"
    elif [[ "$cs_act" != "active" && "$bnc_act" != "active" ]]; then
        echo -e "  Статус: ${YELLOW}ОТКЛЮЧЁН${NC} (crowdsec: ${cs_act:-inactive}, bouncer: ${bnc_act:-inactive}, autostart: ${cs_en:-disabled})"
    else
        echo -e "  Статус: ${YELLOW}ЧАСТИЧНО${NC} (crowdsec: ${cs_act:-inactive}, bouncer: ${bnc_act:-inactive})"
    fi
    if [[ "$cs_act" == "active" ]]; then
        cscli decisions list 2>/dev/null || true
    fi
}

show_security() {
    echo -e "\n${BOLD}${CYAN}=== БЕЗОПАСНОСТЬ И БЛОКИРОВКИ ===${NC}"
    echo -e "${BOLD}[UFW]${NC}"
    ufw status | sed 's/^/  /'
    echo -e "\n${BOLD}[Fail2Ban]${NC}"
    fail2ban-client status sshd 2>/dev/null | grep -E 'Currently|Total' | sed 's/^/  sshd: /' || echo "  sshd: не активен"
    fail2ban-client status nginx-botsearch 2>/dev/null | grep -E 'Currently|Total' | sed 's/^/  nginx: /' || true
    show_crowdsec_block
    if nft list table inet antiscan >/dev/null 2>&1; then
        local cnt pkts
        cnt=$(nft list set inet antiscan scanners_v4 2>/dev/null | grep -c '/' || echo 0)
        pkts=$(nft list chain inet antiscan prerouting 2>/dev/null | grep -oE 'packets [0-9]+' || echo "packets 0")
        echo -e "\n${BOLD}[Antiscan nftables]${NC} ~${cnt} сетей | отброшено: ${pkts}"
    fi
    echo ""
}

crowdsec_enable() {
    if ! command -v cscli >/dev/null 2>&1; then
        local ram_mb ans
        ram_mb=$(awk '/^MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)
        echo -e "${YELLOW}CrowdSec не установлен.${NC}"
        if [[ "$ram_mb" -gt 0 && "$ram_mb" -lt 1200 ]]; then
            echo -e "${YELLOW}Внимание: доступно ${ram_mb} МБ RAM (для CrowdSec рекомендуется от 1200 МБ).${NC}"
        fi
        if [[ -t 0 ]]; then
            read -erp "Установить CrowdSec + nftables bouncer сейчас? [Y/n]: " ans
            [[ "${ans:-Y}" =~ ^[Nn]$ ]] && { echo "Отменено."; return 0; }
        fi
        # shellcheck disable=SC1091
        source "${INSTALL_DIR}/lib/common.sh"
        if install_crowdsec; then
            [[ -f "$STATE_FILE" ]] && save_var ENABLE_CROWDSEC "true"
            return 0
        fi
        echo -e "${RED}[ERR] Не удалось установить CrowdSec.${NC}"
        return 1
    fi

    local bouncer_unit=false
    if systemctl list-unit-files crowdsec-firewall-bouncer.service 2>/dev/null | grep -q 'crowdsec-firewall-bouncer\.service'; then
        bouncer_unit=true
    fi

    systemctl enable --now crowdsec >/dev/null 2>&1 || {
        echo -e "${RED}[ERR] Не удалось запустить службу crowdsec.${NC}"
        return 1
    }
    if $bouncer_unit; then
        systemctl enable --now crowdsec-firewall-bouncer >/dev/null 2>&1 || \
            echo -e "${YELLOW}[WARN] Не удалось запустить crowdsec-firewall-bouncer.${NC}"
    fi
    if [[ -f "$STATE_FILE" ]]; then
        # shellcheck disable=SC1091
        source "${INSTALL_DIR}/lib/common.sh" && save_var ENABLE_CROWDSEC "true"
    fi
    if systemctl is-active --quiet crowdsec; then
        echo -e "${GREEN}[OK] CrowdSec включён.${NC}"
    else
        echo -e "${RED}[ERR] Служба crowdsec не запустилась.${NC}"
        return 1
    fi
}

crowdsec_disable() {
    if ! command -v cscli >/dev/null 2>&1; then
        echo -e "${YELLOW}CrowdSec не установлен.${NC}"
        return 0
    fi
    systemctl disable --now crowdsec-firewall-bouncer >/dev/null 2>&1 || true
    systemctl disable --now crowdsec >/dev/null 2>&1 || true
    nft delete table ip crowdsec 2>/dev/null || true
    nft delete table ip6 crowdsec 2>/dev/null || true
    if [[ -f "$STATE_FILE" ]]; then
        # shellcheck disable=SC1091
        source "${INSTALL_DIR}/lib/common.sh" && save_var ENABLE_CROWDSEC "false"
    fi
    echo -e "${YELLOW}[OK] CrowdSec отключён (блокировки nftables сняты, настройки сохранены).${NC}"
}

_crowdsec_delete_decision() {
    local flag="$1" val="$2" label="$3" out
    if out=$(cscli decisions delete "$flag" "$val" 2>&1); then
        if grep -qi 'no decision' <<<"$out"; then
            echo -e "${YELLOW}[WARN] ${label}: запись не найдена или уже истекла.${NC}"
        else
            echo -e "${GREEN}[OK] Удалено: ${label}.${NC}"
        fi
    else
        echo -e "${YELLOW}[WARN] ${label}: ${out}${NC}"
    fi
}

crowdsec_unban() {
    if ! command -v cscli >/dev/null 2>&1; then
        echo -e "${YELLOW}CrowdSec не установлен.${NC}"
        return 1
    fi
    if ! systemctl is-active --quiet crowdsec; then
        echo -e "${YELLOW}Служба CrowdSec отключена — управление блокировками недоступно, пока CrowdSec остановлен.${NC}"
        return 1
    fi

    if [[ $# -gt 0 ]]; then
        local yes=false arg out
        local targets=()
        for arg in "$@"; do
            case "$arg" in
                -y|--yes) yes=true ;;
                *) targets+=("$arg") ;;
            esac
        done
        if [[ ${#targets[@]} -eq 0 ]]; then
            echo "Использование: my3xui security crowdsec unban [ID|IP|CIDR|all] [-y]"
            return 1
        fi
        for arg in "${targets[@]}"; do
            if [[ "$arg" == "all" ]]; then
                if ! $yes; then
                    local confirm=""
                    read -erp "Удалить ВСЕ активные блокировки CrowdSec? [y/N]: " confirm
                    [[ "${confirm:-N}" =~ ^[Yy]$ ]] || { echo "Отменено."; continue; }
                fi
                if out=$(cscli decisions delete --all 2>&1); then
                    echo -e "${GREEN}[OK] Все активные блокировки CrowdSec удалены.${NC}"
                else
                    echo -e "${RED}[ERR] Не удалось удалить блокировки: ${out}${NC}"
                    return 1
                fi
            elif [[ "$arg" =~ ^[0-9]+$ ]]; then
                _crowdsec_delete_decision "--id" "$arg" "ID:${arg}"
            elif [[ "$arg" == */* && "$arg" != -* ]]; then
                _crowdsec_delete_decision "--range" "$arg" "подсеть ${arg}"
            elif [[ "$arg" != -* && "$arg" =~ ^[0-9a-fA-F:.]+$ ]]; then
                _crowdsec_delete_decision "--ip" "$arg" "IP ${arg}"
            else
                echo -e "${RED}[ERR] Некорректный идентификатор или IP: ${arg}${NC}"
                return 1
            fi
        done
        return 0
    fi

    local raw_json list_out sel parsed
    if ! raw_json=$(cscli decisions list -o json 2>&1); then
        echo -e "${RED}[ERR] Не удалось получить список блокировок CrowdSec: ${raw_json}${NC}"
        return 1
    fi
    if ! list_out=$(python3 "${INSTALL_DIR}/lib/crowdsec.py" list <<<"$raw_json" 2>&1); then
        echo -e "${RED}[ERR] ${list_out}${NC}"
        return 1
    fi
    if [[ -z "$list_out" ]]; then
        echo -e "  Активных локальных блокировок CrowdSec нет."
        return 0
    fi

    echo -e "\n${BOLD}Активные блокировки CrowdSec:${NC}"
    echo "$list_out"
    echo ""
    read -erp "Номера (напр. 1 3, 1-3), IP или 'all' [Enter — отмена]: " sel
    [[ -n "${sel// /}" && "$sel" != "0" && "$sel" != "q" ]] || { echo "Отменено."; return 0; }

    if ! parsed=$(python3 "${INSTALL_DIR}/lib/crowdsec.py" select --query="$sel" <<<"$raw_json" 2>&1); then
        echo -e "${RED}[ERR] ${parsed}${NC}"
        return 1
    fi

    local is_all=false count=0 kind f1 f2
    local ids=() vals=()
    while IFS=$'\t' read -r kind f1 f2 _; do
        if [[ "$kind" == "META" ]]; then
            [[ "$f1" == "all" ]] && is_all=true
            count="$f2"
        elif [[ "$kind" == "ITEM" ]]; then
            ids+=("$f1")
            vals+=("$f2")
        fi
    done <<<"$parsed"

    [[ ${#ids[@]} -gt 0 ]] || { echo "Отменено."; return 0; }

    if $is_all; then
        local confirm=""
        read -erp "Удалить ВСЕ перечисленные блокировки (${count} шт.)? [y/N]: " confirm
        [[ "${confirm:-N}" =~ ^[Yy]$ ]] || { echo "Отменено."; return 0; }
    fi

    local i
    for i in "${!ids[@]}"; do
        _crowdsec_delete_decision "--id" "${ids[$i]}" "ID:${ids[$i]} (${vals[$i]})"
    done
}

security_menu() {
    while true; do
        echo "  [1] Обновить статус          [2] Включить CrowdSec"
        echo "  [3] Отключить CrowdSec       [4] Удалить блокировки CrowdSec"
        echo "  [0] Назад"
        read -erp "  Действие (Безопасность): " sc
        case "${sc:-0}" in
            1) show_security ;;
            2) crowdsec_enable || true ;;
            3) crowdsec_disable || true ;;
            4) crowdsec_unban || true ;;
            0|"") break ;;
            *) echo -e "${YELLOW}Неизвестный выбор.${NC}" ;;
        esac
    done
}

crowdsec_manage() {
    local sub="${1:-menu}"
    [[ $# -gt 0 ]] && shift
    case "$sub" in
        status)
            show_crowdsec_block
            echo ""
            ;;
        enable|on)
            crowdsec_enable
            ;;
        disable|off)
            crowdsec_disable
            ;;
        unban|delete|del)
            crowdsec_unban "$@"
            ;;
        menu)
            if [[ -t 0 ]]; then
                show_crowdsec_block
                echo ""
                security_menu
            else
                show_crowdsec_block
                echo ""
            fi
            ;;
        *)
            echo "Использование: my3xui security crowdsec [status|enable|disable|unban [ID|IP|CIDR|all]]"
            return 1
            ;;
    esac
}

security_manage() {
    local sub="${1:-status}"
    [[ $# -gt 0 ]] && shift
    case "$sub" in
        status)
            show_security
            ;;
        menu)
            show_security
            security_menu
            ;;
        crowdsec|cs)
            crowdsec_manage "$@"
            ;;
        enable|on)
            crowdsec_enable
            ;;
        disable|off)
            crowdsec_disable
            ;;
        unban|delete|del)
            crowdsec_unban "$@"
            ;;
        *)
            echo "Использование: my3xui security [status|menu|crowdsec <status|enable|disable|unban>]"
            return 1
            ;;
    esac
}

run_audit() {
    echo -e "\n${BOLD}${CYAN}=== АУДИТ НОДЫ (${DOMAIN:-N/A}) ===${NC}"
    local ok="${GREEN}[OK]${NC}" bad="${RED}[FAIL]${NC}"

    ss -tlnp | grep -q ':443 ' && echo -e "  ${ok} Xray слушает порт 443" || echo -e "  ${bad} Порт 443 не слушается"
    ss -tlnp | grep -q '127.0.0.1:8443' && echo -e "  ${ok} Nginx слушает 127.0.0.1:8443" || echo -e "  ${bad} Nginx 8443 не слушается"
    ss -tlnp | grep -q '127.0.0.1:11443' && echo -e "  ${ok} XHTTP слушает 127.0.0.1:11443" || echo -e "  ${bad} XHTTP 11443 не слушается"
    nginx -t >/dev/null 2>&1 && echo -e "  ${ok} nginx -t валиден" || echo -e "  ${bad} Ошибка nginx -t"

    if [[ -n "${DOMAIN:-}" ]]; then
        local code
        code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 6 --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/" || echo "000")
        [[ "$code" == "200" ]] && echo -e "  ${ok} Маскировка https://${DOMAIN}/ -> HTTP ${code}" || echo -e "  ${bad} Маскировка вернула HTTP ${code}"
    fi

    # Geo-файлы обновляются таймером; упавший запуск виден как failed.
    if systemctl is-active --quiet 3xui-node-geo-update.timer; then
        if systemctl is-failed --quiet 3xui-node-geo-update.service; then
            echo -e "  ${bad} Последнее обновление geo-файлов завершилось ошибкой (journalctl -u 3xui-node-geo-update)"
        else
            echo -e "  ${ok} Таймер обновления geo-файлов активен"
        fi
    else
        echo -e "  ${bad} Таймер обновления geo-файлов не активен"
    fi

    # Psiphon проверяется по факту: запрос через его SOCKS5 должен выйти не с IP сервера.
    if [[ "${AI_MODE:-none}" == "psiphon" ]]; then
        local pip
        pip=$(curl -4 -fsS --max-time 15 --socks5-hostname "127.0.0.1:${PSIPHON_PORT:-1080}" https://api.ipify.org 2>/dev/null || true)
        if [[ -n "$pip" && "$pip" != "${SERVER_IP:-}" ]]; then
            echo -e "  ${ok} Туннель Psiphon работает (выход ${pip})"
        else
            echo -e "  ${bad} Туннель Psiphon не отвечает — vps-psiphon, journalctl -u vps-psiphon"
        fi
        [[ "${PSIPHON_STATUS:-}" == "failed" ]] && \
            echo -e "  ${bad} Маршруты Gemini через Psiphon не применены при установке — my3xui run 06_ai_routing"
    fi

    if [[ -n "${SERVER_IP:-}" ]]; then
        if ! curl -skI --max-time 4 "https://${SERVER_IP}/" >/dev/null 2>&1; then
            echo -e "  ${ok} Запрос по IP (${SERVER_IP}) отклонён (ssl_reject_handshake)"
        else
            echo -e "  ${bad} Сервер отвечает по голому IP!"
        fi
    fi

    vpn_probe
    echo ""
}

# Сквозная проверка VPN: временный клиент Xray по каждой ссылке user1 из панели подключается
# к 443 этого сервера так же, как клиент из подписки, и делает запрос наружу.
vpn_probe() {
    local ok="${GREEN}[OK]${NC}" bad="${RED}[FAIL]${NC}" warn="${YELLOW}[WARN]${NC}"
    local xray_bin links link name res exit_ip
    xray_bin=$(find /usr/local/x-ui/bin -maxdepth 1 -name "xray-linux-*" -type f 2>/dev/null | head -n 1 || true)
    if [[ -z "$xray_bin" || -z "${DOMAIN:-}" ]]; then
        echo -e "  ${bad} Сквозная проверка VPN невозможна: нет Xray или домена в state.env"
        return 0
    fi
    # Подоболочка: log_err из common.sh завершает её, а не весь аудит.
    # shellcheck disable=SC1091
    if ! links=$(set +e; source "${INSTALL_DIR}/lib/common.sh" && load_state \
            && ensure_xui_api_token >/dev/null 2>&1 \
            && python3 "${INSTALL_DIR}/lib/xui_api.py" client-links --email=user1 \
                --panel-port="${PANEL_PORT}" --panel-path="${PANEL_PATH}" \
                --panel-user="${PANEL_USER}" --panel-pass="${PANEL_PASS}" 2>/dev/null); then
        echo -e "  ${bad} Панель не отдала ссылки клиента user1 — сквозная проверка VPN пропущена"
        return 0
    fi
    while IFS= read -r link; do
        [[ -n "$link" ]] || continue
        case "$link" in
            *type=xhttp*) name="XHTTP (443 → nginx → Xray)" ;;
            *security=reality*) name="Reality" ;;
            *) name="${link%%\?*}" ;;
        esac
        # Сертификат закрепляется по файлу nginx: проверяется, что ответил именно этот сервер.
        res=$(python3 "${INSTALL_DIR}/lib/xray_client.py" probe --xray "$xray_bin" --link="$link" \
              --url https://api.ipify.org --resolve "${DOMAIN}:127.0.0.1" \
              --pin-cert-file "/etc/nginx/ssl/${DOMAIN}/fullchain.pem" --timeout 15 2>&1 || true)
        if [[ "$(jq -r '.ok // false' <<<"$res" 2>/dev/null)" == "true" ]]; then
            exit_ip=$(jq -r '.body' <<<"$res")
            if [[ "$exit_ip" == "${SERVER_IP:-}" ]]; then
                echo -e "  ${ok} VPN ${name}: трафик проходит (внешний IP ${exit_ip})"
            else
                echo -e "  ${warn} VPN ${name}: трафик проходит, но внешний IP ${exit_ip:-?} ≠ ${SERVER_IP:-?} (NAT у провайдера?)"
            fi
        else
            echo -e "  ${bad} VPN ${name}: трафик не проходит — $(jq -r '.error // empty' <<<"$res" 2>/dev/null || echo "$res")"
        fi
    done <<<"$links"
}

ssh_manage() {
    local sub="${1:-status}"
    local ssh_unit="ssh.service"
    systemctl list-unit-files sshd.service >/dev/null 2>&1 && ! systemctl list-unit-files ssh.service >/dev/null 2>&1 && ssh_unit="sshd.service"

    case "$sub" in
        status)
            echo -e "\n${BOLD}${CYAN}=== СТАТУС SSH (Termius) ===${NC}"
            echo "  Порт:      ${SSH_PORT:-22}"
            echo "  Служба:    $(systemctl is-active "$ssh_unit" 2>/dev/null || echo off) (socket: $(systemctl is-active ssh.socket 2>/dev/null || echo inactive))"
            if [[ -f /etc/ssh/sshd_config.d/00-keys-only.conf ]]; then
                echo -e "  Пароль:    ${GREEN}ОТКЛЮЧЁН (только ключи)${NC}"
            else
                echo -e "  Пароль:    ${YELLOW}ВКЛЮЧЁН${NC}"
            fi
            echo "  Ключи в /root/.ssh/authorized_keys:"
            if [[ -s /root/.ssh/authorized_keys ]]; then
                ssh-keygen -lf /root/.ssh/authorized_keys 2>/dev/null | sed 's/^/    /' || true
            else
                echo "    (нет ключей)"
            fi
            echo ""
            ;;
        add-key)
            read -erp "Вставьте публичный SSH-ключ (ssh-ed25519 ...): " k
            [[ -n "$k" ]] || { echo "Пустой ввод."; return; }
            if printf '%s\n' "$k" | ssh-keygen -lf - >/dev/null 2>&1; then
                mkdir -p /root/.ssh && chmod 700 /root/.ssh
                touch /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys
                grep -qxF "$k" /root/.ssh/authorized_keys || echo "$k" >> /root/.ssh/authorized_keys
                echo -e "${GREEN}[OK] Ключ добавлен.${NC}"
            else
                echo -e "${RED}[ERR] Некорректный формат SSH-ключа.${NC}"
            fi
            ;;
        lock-password)
            if [[ ! -s /root/.ssh/authorized_keys ]]; then
                echo -e "${RED}[ERR] Нет ключей в /root/.ssh/authorized_keys! Сначала: my3xui ssh add-key${NC}"
                return 1
            fi
            cat <<'EOF' > /etc/ssh/sshd_config.d/00-keys-only.conf
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
EOF
            sshd -t && systemctl restart "$ssh_unit"
            echo -e "${GREEN}[OK] Вход по паролю отключён. Проверьте оба устройства Termius!${NC}"
            ;;
        unlock-password)
            rm -f /etc/ssh/sshd_config.d/00-keys-only.conf
            sshd -t && systemctl restart "$ssh_unit"
            echo -e "${YELLOW}[OK] Вход по паролю временно разрешён.${NC}"
            ;;
        change-port)
            local old_p="${SSH_PORT:-22}"
            read -erp "Новый порт SSH (1024-39999): " new_p
            [[ "$new_p" =~ ^[0-9]+$ ]] && (( new_p >= 1024 && new_p <= 39999 )) || { echo -e "${RED}Некорректный порт.${NC}"; return 1; }
            local bak
            bak="/root/ssh-bak-$(date +%s)"
            cp -a /etc/ssh "$bak"
            sed -i -E "s/^Port .*/Port ${new_p}/" /etc/ssh/sshd_config.d/00-custom-ssh.conf 2>/dev/null || echo "Port ${new_p}" > /etc/ssh/sshd_config.d/00-custom-ssh.conf
            sshd -t || { cp -a "${bak}/." /etc/ssh/; echo -e "${RED}Ошибка sshd -t.${NC}"; return 1; }
            ufw allow "${new_p}/tcp" comment 'SSH' >/dev/null
            systemd-run --unit=ssh-port-rollback --on-active=180s /bin/bash -c "cp -a '${bak}/.' /etc/ssh/ && systemctl restart ${ssh_unit}" >/dev/null 2>&1 || true
            systemctl restart "$ssh_unit"
            echo -e "${YELLOW}Проверьте во 2-й вкладке Termius: ssh -p ${new_p} root@${SERVER_IP:-IP}${NC}"
            if read -t 170 -erp "Подключение работает? [y/N]: " ok && [[ "${ok:-N}" =~ ^[Yy]$ ]]; then
                systemctl stop ssh-port-rollback.timer 2>/dev/null || true
                ufw delete allow "${old_p}/tcp" >/dev/null 2>&1 || true
                sed -i "s|^port = .*|port = ${new_p}|" /etc/fail2ban/jail.local
                systemctl restart fail2ban 2>/dev/null || true
                source "${INSTALL_DIR}/lib/common.sh" && save_var SSH_PORT "$new_p"
                /usr/local/sbin/update-antiscan.py >/dev/null 2>&1 || true
                rm -rf "$bak"
                echo -e "${GREEN}[OK] SSH перенесён на порт ${new_p}.${NC}"
            else
                cp -a "${bak}/." /etc/ssh/ && systemctl restart "$ssh_unit"
                systemctl stop ssh-port-rollback.timer 2>/dev/null || true
                ufw delete allow "${new_p}/tcp" >/dev/null 2>&1 || true
                rm -rf "$bak"
                echo -e "${YELLOW}Порт откатан на ${old_p}.${NC}"
            fi
            ;;
        *)
            echo "Использование: my3xui ssh [status|add-key|lock-password|unlock-password|change-port]"
            ;;
    esac
}

mask_manage() {
    local sub="${1:-status}"
    local mask_api_conf="/etc/nginx/conf.d/masksite-api/site.conf"
    case "$sub" in
        status)
            echo -e "\n${BOLD}${CYAN}=== МАСКИРОВКА ДОМЕНА (${DOMAIN:-N/A}) ===${NC}"
            echo "  Шаблон:      ${MASK_TEMPLATE:-N/A}"
            echo "  Бренд:       ${BRAND_NAME:-N/A}"
            echo "  Регион:      ${NODE_REGION:-N/A} | Версия: ${APP_VER:-N/A}"
            [[ -n "${MASK_SEED:-}" ]] && echo "  Seed:        ${MASK_SEED}"
            [[ "${MASK_TEMPLATE:-}" == "reverse-proxy" ]] && echo "  Proxy URL:   ${REVERSE_PROXY_URL:-N/A}"
            if [[ -d /var/www/masksite ]]; then
                local fcount
                fcount=$(find /var/www/masksite -type f 2>/dev/null | wc -l)
                echo "  Файлов:      ${fcount} в /var/www/masksite"
            fi
            echo ""
            ;;
        list)
            echo -e "\n${BOLD}${CYAN}=== ДОСТУПНЫЕ ШАБЛОНЫ ===${NC}"
            python3 "${INSTALL_DIR}/lib/mask_site.py" list --templates-dir="${INSTALL_DIR}/templates/sites" | while IFS=$'\t' read -r tid title desc; do
                printf "  %-16s %s — %s\n" "$tid" "$title" "$desc"
            done
            printf "  %-16s %s\n" "random" "Случайный локальный портал"
            printf "  %-16s %s\n\n" "reverse-proxy" "Обратный прокси на внешний URL"
            ;;
        set)
            local tpl="${2:-}"
            local rp_url="${3:-}"
            [[ -n "$tpl" ]] || { echo "Использование: my3xui mask set <cloud-storage|status-hub|dev-docs|saas-analytics|tech-journal|random|reverse-proxy> [url]"; return 1; }
            [[ -n "${DOMAIN:-}" ]] || { echo -e "${RED}Домен не задан в ${STATE_FILE}.${NC}"; return 1; }
            # shellcheck disable=SC1091
            source "${INSTALL_DIR}/lib/common.sh"
            case "$tpl" in
                reverse-proxy)
                    if [[ -z "$rp_url" ]]; then
                        read -erp "URL для Reverse Proxy (https://...): " rp_url
                        rp_url=$(echo "$rp_url" | tr -d '[:space:]')
                    fi
                    [[ -n "$rp_url" ]] || { echo -e "${RED}Не указан URL для reverse-proxy.${NC}"; return 1; }
                    save_var MASK_TEMPLATE "reverse-proxy"
                    save_var REVERSE_PROXY_URL "$rp_url"
                    rm -rf /var/www/masksite/*
                    python3 "${INSTALL_DIR}/lib/mask_site.py" cleanup-api-conf --nginx-api-conf="${mask_api_conf}"
                    bash "${INSTALL_DIR}/install.sh" --only 07_nginx_config
                    ;;
                *)
                    local meta new_tpl new_brand new_seed new_region new_ver
                    meta=$(python3 "${INSTALL_DIR}/lib/mask_site.py" deploy \
                        --templates-dir="${INSTALL_DIR}/templates/sites" \
                        --template="${tpl}" \
                        --domain="${DOMAIN}" \
                        --output-dir=/var/www/masksite \
                        --nginx-api-conf="${mask_api_conf}")
                    new_tpl=$(jq -r '.template' <<<"$meta")
                    new_brand=$(jq -r '.brand_name' <<<"$meta")
                    new_seed=$(jq -r '.mask_seed' <<<"$meta")
                    new_region=$(jq -r '.node_region' <<<"$meta")
                    new_ver=$(jq -r '.app_ver' <<<"$meta")
                    chown -R www-data:www-data /var/www/masksite
                    save_var MASK_TEMPLATE "$new_tpl"
                    save_var REVERSE_PROXY_URL ""
                    save_var BRAND_NAME "$new_brand"
                    save_var MASK_SEED "$new_seed"
                    save_var NODE_REGION "$new_region"
                    save_var APP_VER "$new_ver"
                    bash "${INSTALL_DIR}/install.sh" --only 07_nginx_config
                    echo -e "${GREEN}[OK] Развёрнут портал ${new_tpl} (${new_brand}, seed: ${new_seed}).${NC}"
                    ;;
            esac
            ;;
        regen)
            local cur="${MASK_TEMPLATE:-cloud-storage}"
            if [[ "$cur" == "reverse-proxy" ]]; then
                echo -e "${YELLOW}Перегенерация доступна только для автономных шаблонов (текущий: ${cur}).${NC}"
                return 1
            fi
            mask_manage set "$cur"
            ;;
        *)
            echo "Использование: my3xui mask [status|list|set <шаблон> [url]|regen]"
            ;;
    esac
}

self_update() {
    [[ -f "${INSTALL_DIR}/.repo" ]] || { echo -e "${RED}Файл ${INSTALL_DIR}/.repo не найден.${NC}"; return 1; }
    # shellcheck disable=SC1091
    source "${INSTALL_DIR}/.repo"
    echo -e "${CYAN}Обновление модулей из ${GH_REPO} (${GH_BRANCH})...${NC}"
    GH_REPO="$GH_REPO" GH_BRANCH="$GH_BRANCH" bash <(curl -fsSL "https://raw.githubusercontent.com/${GH_REPO}/${GH_BRANCH}/bootstrap.sh") --only 08_cli_and_audit
}

clean_server() {
    echo -e "\n${RED}${BOLD}ВНИМАНИЕ! ПОЛНАЯ ОЧИСТКА НОДЫ!${NC}"
    echo "Будут удалены 3x-ui, Xray, Nginx, CrowdSec, Fail2Ban, Antiscan, Psiphon, DoT/DoH и /opt/3xui-node."
    echo "(Настройки SSH сохраняются, чтобы вы не потеряли доступ.)"
    read -erp "Введите YES для подтверждения: " c1
    [[ "$c1" == "YES" ]] || { echo "Отменено."; return; }

    export DEBIAN_FRONTEND=noninteractive
    systemctl stop x-ui nginx fail2ban crowdsec crowdsec-firewall-bouncer cloudflared-doh 3xui-node-doh antiscan-update.timer 2>/dev/null || true
    systemctl disable x-ui nginx fail2ban crowdsec crowdsec-firewall-bouncer cloudflared-doh 3xui-node-doh antiscan-restore.service antiscan-update.timer 2>/dev/null || true

    [[ -x /usr/local/x-ui/x-ui ]] && printf "y\n" | /usr/local/x-ui/x-ui uninstall >/dev/null 2>&1 || true
    # Psiphon удаляет сам себя полностью (юниты, контейнер, образ, конфиг, CLI).
    if command -v vps-psiphon >/dev/null 2>&1; then
        vps-psiphon uninstall >/dev/null 2>&1 || true
    fi
    docker rm -f vps-psiphon >/dev/null 2>&1 || true
    systemctl disable --now 3xui-node-geo-update.timer >/dev/null 2>&1 || true

    apt-get purge -y -qq nginx nginx-common nginx-core crowdsec crowdsec-firewall-bouncer-nftables fail2ban >/dev/null 2>&1 || true
    apt-get autoremove -y -qq >/dev/null 2>&1 || true

    nft delete table inet antiscan 2>/dev/null || true
    nft delete table ip crowdsec 2>/dev/null || true
    nft delete table ip6 crowdsec 2>/dev/null || true
    ufw --force disable >/dev/null 2>&1 || true
    ufw --force reset >/dev/null 2>&1 || true

    rm -rf /usr/local/x-ui /etc/x-ui /etc/nginx /var/www/masksite /var/www/geo /var/cache/nginx \
           /etc/crowdsec /var/lib/crowdsec /etc/fail2ban /etc/3xui-node /opt/vps-psiphon /opt/3xui-node \
           /etc/3xui-antiscan-allow.txt /etc/nftables.d/antiscan.nft /usr/local/sbin/update-antiscan.py \
           /usr/local/sbin/update-geo-mirror.sh /usr/local/bin/cloudflared \
           /etc/systemd/system/antiscan-* /etc/systemd/system/nginx.service.d /etc/systemd/system/x-ui.service.d \
           /etc/systemd/system/cloudflared-doh.service /etc/systemd/system/3xui-node-doh.service /etc/systemd/resolved.conf.d/10-dot.conf \
           /etc/apt/sources.list.d/nginx.list /etc/apt/preferences.d/99nginx /usr/share/keyrings/nginx-archive-keyring.gpg \
           /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh \
           /etc/sysctl.d/99-xray-custom.conf /etc/cron.d/update-geo-mirror /etc/update-motd.d/99-my3xui \
           /root/vps-credentials.txt /root/3xui-node-backups /var/log/3xui-node-install.log /usr/local/bin/my3xui \
           /usr/bin/x-ui /etc/systemd/system/x-ui.service /var/log/3xui-node-xui-install.log \
           /usr/local/sbin/3xui-node-geo-update /etc/systemd/system/3xui-node-geo-update.service \
           /etc/systemd/system/3xui-node-geo-update.timer /var/log/3xui-node-psiphon-install.log

    systemctl restart systemd-resolved 2>/dev/null || true
    sysctl --system >/dev/null 2>&1 || true
    systemctl daemon-reload
    echo -e "${GREEN}${BOLD}Очистка завершена.${NC}"
    exit 0
}

case "${1:-}" in
    info)            show_info ;;
    creds)           show_creds ;;
    security)        shift; security_manage "$@" ;;
    audit)           run_audit ;;
    ssh)             ssh_manage "${2:-status}" ;;
    mask)            mask_manage "${2:-status}" "${3:-}" "${4:-}" ;;
    update-scanners) /usr/local/sbin/update-antiscan.py ;;
    run)             bash "${INSTALL_DIR}/install.sh" --only "${2:-}" ;;
    self-update)     self_update ;;
    clean)           clean_server ;;
    *)
        while true; do
            echo -e "${BOLD}${CYAN}--------------------------------------------${NC}"
            echo -e "${BOLD}  my3xui CLI  (${DOMAIN:-VPS})${NC}"
            echo -e "${BOLD}${CYAN}--------------------------------------------${NC}"
            echo "  1. Информация о системе"
            echo "  2. Доступы и ссылки VLESS"
            echo "  3. Безопасность (UFW/F2B/CrowdSec/Antiscan)"
            echo "  4. Полный аудит + E2E тест VPN"
            echo "  5. Управление SSH (ключи / порт / пароль)"
            echo "  6. Маскировка домена (шаблон сайта)"
            echo "  7. Обновить списки сканеров"
            echo "  8. Обновить модули из GitHub"
            echo -e "  9. ${RED}Полная очистка сервера${NC}"
            echo "  0. Выход"
            read -erp "Выбор [0-9]: " ch
            case "$ch" in
                1) show_info ;;
                2) show_creds ;;
                3) show_security; security_menu ;;
                4) run_audit ;;
                5)
                    echo "  [1] status  [2] add-key  [3] lock-password"
                    echo "  [4] unlock-password      [5] change-port"
                    read -erp "  Действие SSH: " sc
                    case "$sc" in
                        1) ssh_manage status ;;
                        2) ssh_manage add-key ;;
                        3) ssh_manage lock-password ;;
                        4) ssh_manage unlock-password ;;
                        5) ssh_manage change-port ;;
                    esac
                    ;;
                6)
                    mask_manage status
                    echo "  [1] list            [2] set cloud-storage   [3] set status-hub"
                    echo "  [4] set dev-docs    [5] set saas-analytics  [6] set tech-journal"
                    echo "  [7] set random      [8] regen"
                    read -erp "  Действие mask: " mc
                    case "$mc" in
                        1) mask_manage list ;;
                        2) mask_manage set cloud-storage ;;
                        3) mask_manage set status-hub ;;
                        4) mask_manage set dev-docs ;;
                        5) mask_manage set saas-analytics ;;
                        6) mask_manage set tech-journal ;;
                        7) mask_manage set random ;;
                        8) mask_manage regen ;;
                    esac
                    ;;
                7) /usr/local/sbin/update-antiscan.py || true ;;
                8) self_update ;;
                9) clean_server ;;
                0) exit 0 ;;
            esac
        done
        ;;
esac
